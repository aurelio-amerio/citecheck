#!/bin/bash
# Smoke test for plugin bin/ PATH wiring.
# Verifies (a) bin/ scripts are auto-added to PATH when the plugin loads,
# and (b) a bin/ wrapper can resolve relative paths into skills/.../scripts/.
set -e

PLUGIN_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"

echo "citecheck-hello: I am on PATH and running"
echo "  resolved path:    $(readlink -f "$0")"
echo "  plugin root:      ${PLUGIN_ROOT}"
echo "  which says:       $(which citecheck-hello)"
echo "  args received:    $*"
echo
echo "Calling skills/citecheck-deep/scripts/summarize_deep_report.py --help via wrapper pattern:"
echo "---"
python3 "${PLUGIN_ROOT}/skills/citecheck-deep/scripts/summarize_deep_report.py" --help
echo "---"
echo "Wrapper pattern works."
